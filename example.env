# Environment variable definitions
# Copy this file to .env and customize as needed

# =============================================================================
# Application Settings
# =============================================================================

# Logging level (valid options: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Logging format (valid options: pretty, json)
LOG_FORMAT=pretty

# =============================================================================
# Celery Settings
# =============================================================================

# Redis connection for message broker
# Format: redis://[user:password@]host:port/db
# Default uses service name 'redis' from docker-compose
CELERY_BROKER_URL=redis://localhost:6379/0

# Redis connection for result backend
# Uses separate database (1) from broker (0) for better organization
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Worker concurrency (number of worker processes)
# Default: number of CPU cores
# CELERY_WORKER_CONCURRENCY=4

# Task result expiration time in seconds
# Default: 86400 (24 hours)
# CELERY_RESULT_EXPIRES=86400

# Worker log level
# Valid options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# CELERY_WORKER_LOGLEVEL=INFO

# =============================================================================
# Local Development Override
# =============================================================================

# When running Celery worker locally (not in Docker), use localhost
# Uncomment these lines if running worker with: uv run celery -A celery_poc.tasks worker
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# Other Settings
# =============================================================================

# Add other environment variables as needed
# DATABASE_URL=
# API_KEY=
# SECRET_KEY=
